# Copy this file to .supabase.env and fill in the values. .supabase.env is git-ignored.
# Lines starting with # are ignored. No quotes, no spaces around the values.

# Supabase dashboard -> "Connect" button. Looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Settings -> API Keys -> Publishable key (starts with sb_publishable_). Safe for the app.
SUPABASE_PUBLISHABLE_KEY=

# Settings -> API Keys -> Secret keys (starts with sb_secret_). FULL ACCESS: this PC only.
SUPABASE_SECRET_KEY=

# The email of the app login (Authentication -> Users) that owns the wardrobe.
SUPABASE_OWNER_EMAIL=
